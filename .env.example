# Copy to .env.local. Vite reads these at build time, so a store build
# must have them set before `npm run build`.

# Native release builds fall back to the Koyeb API when this is unset.
# Web production builds fall back to /api/.
VITE_API_URL=

# Web OAuth client id. Native Google Sign-In uses this to request a server auth code.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Public https URLs. The in-app Privacy Policy and Support links stay hidden until these are set.
VITE_PRIVACY_POLICY_URL=
VITE_SUPPORT_URL=mailto:my.tracker.support@gmail.com
